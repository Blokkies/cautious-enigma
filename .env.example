# Copy to .env.local for local dev. In Coolify, set these as environment variables.

# Postgres connection string (V2 uses its OWN database, separate from legacy)
DATABASE_URL=postgres://user:password@host:5432/stocktake_v2

# Long random string, e.g. `openssl rand -base64 48`. Must differ from legacy so
# legacy login cookies are never accepted by V2.
JWT_SECRET=

# Password for the first admin login. On an empty database, the first successful
# admin login with this password creates the admin account.
ADMIN_PASSWORD=

# Optional
# NEXT_PUBLIC_APP_VERSION=V2   # label shown in the UI and /api/health (build-time)
# SKIP_MIGRATIONS=1           # don't run migrations on container start
# CORS_ORIGIN=                # only if another origin must call the API
